{
  "info": {
    "_postman_id": "auth-module-ad",
    "name": "American Dream - Authentication Module (Auth)",
    "description": "Authentication endpoints: Sign Up, Login, Forget Password, Verify Code, Reset Password, Refresh Token, and Profile /me",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Sign Up (تسجيل حساب جديد)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    var res = pm.response.json();",
              "    if (res.token) pm.collectionVariables.set('token', res.token);",
              "    if (res.refreshToken) pm.collectionVariables.set('refreshToken', res.refreshToken);",
              "    if (res.data && res.data._id) pm.collectionVariables.set('userId', res.data._id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"أحمد محمود\",\n  \"email\": \"user.test@americandream.eg\",\n  \"phone\": \"01012345678\",\n  \"password\": \"Secret123456\",\n  \"passwordConfirm\": \"Secret123456\",\n  \"age\": \"28\",\n  \"gender\": \"male\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/signup",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "signup"]
        }
      }
    },
    {
      "name": "2. Login (تسجيل الدخول)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var res = pm.response.json();",
              "    if (res.token) pm.collectionVariables.set('token', res.token);",
              "    if (res.refreshToken) pm.collectionVariables.set('refreshToken', res.refreshToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user.test@americandream.eg\",\n  \"password\": \"Secret123456\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "3. Get My Profile (الملف الشخصي المحمي)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/me",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "me"]
        }
      }
    },
    {
      "name": "4. Refresh Token (تجديد التوكن)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var res = pm.response.json();",
              "    if (res.token) pm.collectionVariables.set('token', res.token);",
              "    if (res.refreshToken) pm.collectionVariables.set('refreshToken', res.refreshToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/refresh-token",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "refresh-token"]
        }
      }
    },
    {
      "name": "5. Forget Password (إرسال كود التحقق للإيميل)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user.test@americandream.eg\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/forgot-password",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "forgot-password"]
        }
      }
    },
    {
      "name": "6. Verify Reset Code (التحقق من كود الـ 6 أرقام)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user.test@americandream.eg\",\n  \"resetCode\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/verify-code",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "verify-code"]
        }
      }
    },
    {
      "name": "7. Reset Password (تعيين كلمة مرور جديدة)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var res = pm.response.json();",
              "    if (res.token) pm.collectionVariables.set('token', res.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user.test@americandream.eg\",\n  \"newPassword\": \"NewPassword123\",\n  \"newPasswordConfirm\": \"NewPassword123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/reset-password",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "reset-password"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:9500",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    }
  ]
}
