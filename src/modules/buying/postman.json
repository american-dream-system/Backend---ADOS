{
  "info": {
    "_postman_id": "a5e8c1b2-7d34-4a9f-8632-buyingmodule02",
    "name": "American Dream - Buying & Payment Module API",
    "description": "Complete Postman collection for purchasing tickets/packages, manual payments (InstaPay & Vodafone Cash with receipt upload), Cash at Gate, and Admin payment verification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9500",
      "type": "string"
    },
    {
      "key": "buyingId",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderCode",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Payment Accounts & Public Info",
      "item": [
        {
          "name": "1. Get Payment Accounts (InstaPay & Vodafone Cash)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/buying/payment-accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "buying", "payment-accounts"]
            }
          }
        }
      ]
    },
    {
      "name": "Customer Purchasing Flows",
      "item": [
        {
          "name": "2. Create Purchase - Cash on Arrival (No proof required)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var res = pm.response.json();",
                  "    if (res.data) {",
                  "        pm.collectionVariables.set('buyingId', res.data._id);",
                  "        pm.collectionVariables.set('orderCode', res.data.orderCode);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guestName\": \"أحمد محمود\",\n  \"guestPhone\": \"01012345678\",\n  \"paymentMethod\": \"cash\",\n  \"tickets\": [\n    {\n      \"ticket\": \"pass-kids-area\",\n      \"quantity\": 2,\n      \"priceEgp\": 100\n    }\n  ],\n  \"notes\": \"الدفع نقداً عند البوابة\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/buying",
              "host": ["{{baseUrl}}"],
              "path": ["api", "buying"]
            }
          }
        },
        {
          "name": "3. Create Purchase - InstaPay (With Proof & Sender Account)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var res = pm.response.json();",
                  "    if (res.data) {",
                  "        pm.collectionVariables.set('buyingId', res.data._id);",
                  "        pm.collectionVariables.set('orderCode', res.data.orderCode);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guestName\": \"سارة علي\",\n  \"guestPhone\": \"01198765432\",\n  \"paymentMethod\": \"instapay\",\n  \"senderAccount\": \"sara@instapay\",\n  \"paymentProof\": \"/payments/sample-receipt.jpg\",\n  \"tickets\": [\n    {\n      \"ticket\": \"pass-adventure\",\n      \"quantity\": 1,\n      \"priceEgp\": 150\n    }\n  ],\n  \"notes\": \"تم التحويل عبر إنستاباي بنجاح\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/buying",
              "host": ["{{baseUrl}}"],
              "path": ["api", "buying"]
            }
          }
        },
        {
          "name": "4. Upload Payment Proof Later by Order ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentProof\": \"/payments/updated-receipt.jpg\",\n  \"senderAccount\": \"01099887766\",\n  \"paymentMethod\": \"vodafone_cash\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/buying/{{buyingId}}/proof",
              "host": ["{{baseUrl}}"],
              "path": ["api", "buying", "{{buyingId}}", "proof"]
            }
          }
        },
        {
          "name": "5. Get Purchase Details by Order Code",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/buying/code/{{orderCode}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "buying", "code", "{{orderCode}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin & Cashier Verification",
      "item": [
        {
          "name": "6. Admin: Get Orders Pending Receipt Verification",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/buying/pending-verification",
              "host": ["{{baseUrl}}"],
              "path": ["api", "buying", "pending-verification"]
            }
          }
        },
        {
          "name": "7. Admin: Approve Manual Payment Proof",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"approve\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/buying/{{buyingId}}/verify-payment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "buying", "{{buyingId}}", "verify-payment"]
            }
          }
        },
        {
          "name": "8. Admin: Reject Manual Payment Proof",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"reject\",\n  \"rejectionReason\": \"المبلغ المحول في الإيصال غير مطابق لإجمالي التذكرة\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/buying/{{buyingId}}/verify-payment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "buying", "{{buyingId}}", "verify-payment"]
            }
          }
        },
        {
          "name": "9. Cashier: Mark Cash Collected on Arrival (Gate Desk)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/buying/{{buyingId}}/mark-cash-collected",
              "host": ["{{baseUrl}}"],
              "path": ["api", "buying", "{{buyingId}}", "mark-cash-collected"]
            }
          }
        },
        {
          "name": "10. Gate Turnstile: Redeem / Scan Pass by Code",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/buying/code/{{orderCode}}/redeem",
              "host": ["{{baseUrl}}"],
              "path": ["api", "buying", "code", "{{orderCode}}", "redeem"]
            }
          }
        }
      ]
    }
  ]
}
