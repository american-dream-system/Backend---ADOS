  "item": [
    {
      "name": "1. Public Info & Venue Spaces",
      "item": [
        {
          "name": "1.1 Get Available Spaces & Halls",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/spaces",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "spaces"]
            },
            "description": "Lists all 4 venue spaces: Luxury Indoor Hall (120 guests), Panoramic Roof (80 guests), Seaside Lawn (50 guests), and Grand Waterfront Ballroom (450 guests)."
          },
          "response": []
        },
        {
          "name": "1.2 Get Birthday Celebration Packages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/packages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "packages"]
            },
            "description": "Returns birthday tiers: Explorer Adventure (7,500 EGP / 2,500 deposit), Champion Quest (11,500 EGP / 3,500 deposit), and Royal Waterfront VIP (16,500 EGP / 5,000 deposit)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Hall Availability Checks",
      "item": [
        {
          "name": "2.1 Check Availability (Indoor Hall - Afternoon Session)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/availability?space=indoor&date=2026-10-24&session=afternoon",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "availability"],
              "query": [
                {
                  "key": "space",
                  "value": "indoor"
                },
                {
                  "key": "date",
                  "value": "2026-10-24"
                },
                {
                  "key": "session",
                  "value": "afternoon"
                }
              ]
            },
            "description": "Checks whether the indoor hall is already booked for the afternoon slot on this date to prevent double bookings."
          },
          "response": []
        },
        {
          "name": "2.2 Check Availability (Canal Roof - Evening Session)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/availability?space=roof&date=2026-10-25&session=evening",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "availability"],
              "query": [
                {
                  "key": "space",
                  "value": "roof"
                },
                {
                  "key": "date",
                  "value": "2026-10-25"
                },
                {
                  "key": "session",
                  "value": "evening"
                }
              ]
            },
            "description": "Checks availability for the panoramic roof evening session."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Booking Flows & Reservations",
      "item": [
        {
          "name": "3.1 Book Birthday Celebration (Champion Quest - Indoor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var res = pm.response.json();",
                  "    if (res.booking) {",
                  "        pm.collectionVariables.set('bookingId', res.booking._id);",
                  "        pm.collectionVariables.set('bookingCode', res.booking.bookingCode);",
                  "        console.log('Saved bookingId:', res.booking._id);",
                  "        console.log('Saved bookingCode:', res.booking.bookingCode);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contactName\": \"Mona Youssef\",\n  \"contactPhone\": \"01234567890\",\n  \"contactEmail\": \"mona@example.com\",\n  \"eventType\": \"birthday\",\n  \"space\": \"indoor\",\n  \"birthdayDetails\": {\n    \"celebrantName\": \"Youssef\",\n    \"celebrantAge\": \"7-9\",\n    \"packageId\": \"champion\"\n  },\n  \"totalGuests\": 30,\n  \"eventDate\": \"2026-10-24\",\n  \"session\": \"afternoon\",\n  \"sessionTime\": \"04:00 PM – 07:30 PM\",\n  \"specialRequests\": \"Superhero themed backdrop and balloons\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/book",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "book"]
            },
            "description": "Creates birthday reservation with automatic 14% VAT (1,610 EGP), total (13,110 EGP), and required confirmation deposit (3,500 EGP)."
          },
          "response": []
        },
